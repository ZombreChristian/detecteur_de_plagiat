DJANGO_SECRET_KEY=changez-cette-cle
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Base de données
POSTGRES_DB=detecteur_plagiat
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Moteur FastAPI
FASTAPI_URL=http://127.0.0.1:8000
PUBLIC_APP_URL=http://127.0.0.1:8000

# Similarité documentaire
SIMILARITY_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
SIMILARITY_MODEL_DIR=modeles/paraphrase-multilingual-MiniLM-L12-v2
SIMILARITY_LEXICAL_WEIGHT=0.30
SIMILARITY_SEMANTIC_WEIGHT=0.70
SIMILARITY_REFERENCE_TOP_K=10
SIMILARITY_PASSAGE_TOP_K=3
# Facultatif : authentification Hugging Face pour le premier téléchargement
HF_TOKEN=

# Analyse RAG des TDR avec Qwen3:8b local via Ollama.
# Installer le modèle une seule fois : ollama pull qwen3:8b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
TDR_RAG_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=300
# Réglages d’inférence Ollama (à ajuster après mesure sur le PC)
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_BATCH=64
OLLAMA_KEEP_ALIVE=10m
TDR_RAG_REFERENCE_TOP_K=3
TDR_RAG_TOP_K=3
TDR_RAG_CANDIDATE_MAX_CHARS=8000
TDR_RAG_REFERENCE_MAX_CHARS=2600
# Réglages du parcours RAG TDR autonome
TDR_RAG_NUM_CTX=8192
TDR_RAG_NUM_BATCH=64
TDR_RAG_REFERENCE_CHARS=3200
TDR_RAG_CANDIDATE_CHARS=7500
TDR_RAG_INDEPENDENT_MAX_OUTPUT_TOKENS=1800

# Fournisseur du modèle d'arbitrage TDR : ollama (local, par défaut) ou openai_compatible.
TDR_LLM_PROVIDER=ollama
# Pour openai_compatible, renseigner l'URL exacte fournie par l'administrateur du serveur.
# Exemple de forme seulement : https://votre-serveur.example/api
TDR_LLM_BASE_URL=
TDR_LLM_API_KEY=
# Nom exact du modèle sélectionné sur le serveur (vérifier l'ID API auprès de l'administrateur).
TDR_LLM_MODEL=qwen3.8-27b
# Autre modèle visible dans l'interface : huihui-27b-abliterated
# Le délai TDR_RAG_TIMEOUT_SECONDS ci-dessus s'applique aussi au fournisseur distant.

# Envoi réel des e-mails de récupération
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=noreply@votre-domaine.tld
EMAIL_HOST=smtp.votre-fournisseur.tld
EMAIL_PORT=587
EMAIL_HOST_USER=votre-adresse@votre-domaine.tld
EMAIL_HOST_PASSWORD=votre-mot-de-passe-ou-mot-de-passe-application
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=20

# Récupération administrateur en développement uniquement
ALLOW_ADMIN_BOOTSTRAP=False

# Limite de génération JSON pour accélérer l'arbitrage local des TDR
TDR_RAG_MAX_OUTPUT_TOKENS=1200
